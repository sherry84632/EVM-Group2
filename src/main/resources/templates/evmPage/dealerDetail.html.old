<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealer Detail - Account Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/mainPageStyle.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"/>
    <style>
        .dealer-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
        }
        .info-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }
        .staff-table {
            background: white;
            border-radius: 12px;
            overflow: hidden;
        }
        .btn-create-staff {
            background: linear-gradient(135deg, #ff6b35, #f7931e);
            border: none;
            color: white;
        }
        .btn-create-staff:hover {
            background: linear-gradient(135deg, #e55a2b, #e0841a);
            color: white;
        }
    </style>
</head>
<body class="bg-gradient2-custom">

<button class="mobile-menu-toggle" id="menuToggleBtn">
    <i class="fa-solid fa-bars"></i>
</button>

<div class="d-flex">
    <div th:replace="~{mainPage/navBarFragment :: navBar}"></div>

    <div class="mainContent flex-grow-1 p-4">

        <!-- Back Button -->
        <div class="mb-3">
            <a href="/dealer/management" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Back to Dealer Management
            </a>
        </div>

        <!-- Success/Error Message -->
        <div th:if="${message}" class="alert alert-info alert-dismissible fade show" role="alert">
            <span th:text="${message}"></span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>

        <!-- Dealer Header -->
        <div class="dealer-header">
            <h2><i class="fas fa-store"></i> <span th:text="${dealer.dealerName}"></span></h2>
            <p class="mb-0"><i class="fas fa-map-marker-alt"></i> <span th:text="${dealer.address}"></span></p>
        </div>

        <div class="row">
            <!-- Dealer Information -->
            <div class="col-md-4">
                <div class="info-card">
                    <h5 class="mb-3"><i class="fas fa-info-circle"></i> Dealer Information</h5>
                    <p><strong>ID:</strong> <span th:text="${dealer.dealerID}"></span></p>
                    <p><strong>Phone:</strong> <span th:text="${dealer.phone}"></span></p>
                    <p><strong>Email:</strong> <span th:text="${dealer.email}"></span></p>
                    <p><strong>Level ID:</strong> <span th:text="${dealer.levelID}"></span></p>
                    <p><strong>EVM ID:</strong> <span th:text="${dealer.evmID}"></span></p>
                    <p><strong>Policy ID:</strong> <span th:text="${dealer.policyID}"></span></p>
                </div>
            </div>

            <!-- Staff Account Management -->
            <div class="col-md-8">
                <div class="info-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5><i class="fas fa-users"></i> Staff Accounts</h5>
                        <button class="btn btn-create-staff btn-sm" data-bs-toggle="modal" data-bs-target="#createStaffModal">
                            <i class="fas fa-user-plus"></i> Create Staff Account
                        </button>
                    </div>

                    <!-- Staff Table -->
                    <div class="staff-table">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Staff ID</th>
                                    <th>Full Name</th>
                                    <th>Position</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Account ID</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr th:if="${staffList == null or staffList.isEmpty()}">
                                    <td colspan="7" class="text-center text-muted">
                                        <i class="fas fa-info-circle"></i> No staff accounts yet. Create one to get started.
                                    </td>
                                </tr>
                                <tr th:each="staff : ${staffList}">
                                    <td th:text="${staff.staffID}"></td>
                                    <td th:text="${staff.fullName}"></td>
                                    <td><span class="badge bg-info" th:text="${staff.position}"></span></td>
                                    <td th:text="${staff.email}"></td>
                                    <td th:text="${staff.phone}"></td>
                                    <td th:text="${staff.account?.accountId}"></td>
                                    <td>
                                        <span class="badge bg-success" th:if="${staff.account?.active}">Active</span>
                                        <span class="badge bg-secondary" th:unless="${staff.account?.active}">Inactive</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Create Staff Modal -->
<div class="modal fade" id="createStaffModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-plus"></i> Create Staff Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form th:action="@{'/dealer/' + ${dealer.dealerID} + '/staff/create'}" method="post">
                <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}"/>

                <div class="modal-body">
                    <h6 class="text-primary mb-3"><i class="fas fa-key"></i> Account Credentials</h6>

                    <!-- Username -->
                    <div class="mb-3">
                        <label for="username" class="form-label">Username <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="username" name="username" required>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label for="email" class="form-label">Account Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="email" name="email" required>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="password" name="password" required minlength="6">
                        <small class="text-muted">Minimum 6 characters</small>
                    </div>

                    <hr>
                    <h6 class="text-primary mb-3"><i class="fas fa-user-tie"></i> Staff Information</h6>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label for="staffFullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="staffFullName" name="staffFullName" required>
                    </div>

                    <!-- Position -->
                    <div class="mb-3">
                        <label for="staffPosition" class="form-label">Position</label>
                        <input type="text" class="form-control" id="staffPosition" name="staffPosition" placeholder="Sales (default)">
                    </div>

                    <!-- Phone -->
                    <div class="mb-3">
                        <label for="staffPhone" class="form-label">Phone</label>
                        <input type="tel" class="form-control" id="staffPhone" name="staffPhone">
                    </div>

                    <!-- Staff Email -->
                    <div class="mb-3">
                        <label for="staffEmail" class="form-label">Staff Email</label>
                        <input type="email" class="form-control" id="staffEmail" name="staffEmail" placeholder="Leave blank to use account email">
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-create-staff">
                        <i class="fas fa-save"></i> Create Staff Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/scripts/menuProject.js"></script>
</body>
</html>

