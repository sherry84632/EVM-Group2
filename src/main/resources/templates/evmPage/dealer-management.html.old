<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealer Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/homePageStyle.css">
    <link rel="stylesheet" href="/css/mainPageStyle.css">
    <link rel="stylesheet" href="/css/iconStyle.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
          integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
          crossorigin="anonymous" referrerpolicy="no-referrer"/>
    <script>
        // 🟡 Hiển thị dữ liệu Dealer lên form khi nhấn "Edit"
        function editDealer(button) {
            document.getElementById("dealerId").value = button.getAttribute("data-id");
            document.getElementById("dealerName").value = button.getAttribute("data-name");
            document.getElementById("address").value = button.getAttribute("data-address");
            document.getElementById("phone").value = button.getAttribute("data-phone");
            document.getElementById("email").value = button.getAttribute("data-email");
            document.getElementById("levelID").value = button.getAttribute("data-level");
            // evmID và policyID là hidden, không cần set

            document.getElementById("formTitle").innerText = "Update Dealer";
            document.getElementById("submitButton").innerHTML = '<i class="fas fa-save"></i> Update Dealer';

            // 🟢 Khi edit: đặt action thành update
            document.getElementById("dealerForm").action = "/dealer/" + button.getAttribute("data-id") + "/update";
        }

        // 🟢 Reset form về trạng thái thêm mới
        function resetForm() {
            document.getElementById("dealerForm").reset();
            document.getElementById("dealerId").removeAttribute("name"); // xóa name => không gửi dealerID
            document.getElementById("evmID").value = "1"; // Reset evmID to default
            document.getElementById("policyID").value = "0"; // Reset policyID to 0 (NULL)
            document.getElementById("formTitle").innerText = "Add New Dealer";
            document.getElementById("submitButton").innerHTML = '<i class="fas fa-plus"></i> Add Dealer';
            document.getElementById("dealerForm").action = "/dealer/create";
        }

        // 🟢 Tự động ẩn thông báo sau 3 giây
        document.addEventListener("DOMContentLoaded", function() {
            const alertBox = document.querySelector(".alert");
            if (alertBox) {
                setTimeout(() => {
                    alertBox.classList.remove("show");
                    alertBox.classList.add("fade");
                }, 3000);
            }
        });
    </script>
</head>

<body class="bg-light" style="overflow: hidden">

<div class="d-flex">

    <div th:replace="~{mainPage/navBarFragment :: navBar}"></div>

    <div class="mainContent flex-grow-1 p-3" style="overflow-y: auto; overflow-x: hidden; height: 95vh;"> 

        <div class="mainContentVer">
            <h2 class="mb-3">
                <span th:if="${isDealerView}">My Dealer - Staff Management</span>
                <span th:unless="${isDealerView}">Dealer Management</span>
            </h2>

            <!-- Alert Messages -->
            <div th:if="${message}"
                 th:classappend="${messageType == 'error' ? 'alert-danger' : 'alert-success'}"
                 class="alert alert-dismissible fade show"
                 role="alert">
                <i th:class="${messageType == 'error' ? 'fa-solid fa-exclamation-triangle' : 'fa-solid fa-check-circle'} + ' me-2'"></i>
                <span th:text="${message}">Message</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>

            <!-- 🟢 Form Thêm / Cập nhật Dealer - ONLY for ADMIN -->
            <div class="card mb-4 shadow-sm" th:unless="${isDealerView}">
                <div class="card-body">
                    <h5 id="formTitle" class="card-title mb-3">Add New Dealer</h5>

                    <!-- 🔹 Fix CSRF -->
                    <form id="dealerForm" action="/dealer/create" method="post">
                        <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}"/>
                        <!-- 🟢 dealerID chỉ có khi Edit -->
                        <input type="hidden" id="dealerId">
                        <!-- 🟢 evmID hidden với giá trị mặc định 1 -->
                        <input type="hidden" id="evmID" name="evmID" value="1">
                        <!-- 🟢 policyID hidden với giá trị 0 (NULL) -->
                        <input type="hidden" id="policyID" name="policyID" value="0">

                        <div class="row g-2">
                            <div class="col-md-3">
                                <input id="dealerName" name="dealerName" class="form-control" placeholder="Dealer Name *" required>
                            </div>
                            <div class="col-md-3">
                                <input id="address" name="address" class="form-control" placeholder="Address">
                            </div>
                            <div class="col-md-2">
                                <input id="phone" name="phone" class="form-control" placeholder="Phone *" required>
                            </div>
                            <div class="col-md-2">
                                <input id="email" name="email" class="form-control" placeholder="Email *" type="email" required>
                            </div>
                            <div class="col-md-2">
                                <select id="levelID" name="levelID" class="form-select" required>
                                    <option value="">Select Level *</option>
                                    <option th:each="level : ${dealerLevels}"
                                            th:value="${level.levelID}"
                                            th:text="${level.levelName}">
                                    </option>
                                </select>
                            </div>
                            <div class="col-auto d-flex gap-2">
                                <button id="submitButton" class="btn btn-success" type="submit">
                                    <i class="fas fa-plus"></i> Add Dealer
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="resetForm()">
                                    <i class="fas fa-redo"></i> Reset
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Info message for DEALER view -->
            <div class="alert alert-info" th:if="${isDealerView}">
                <i class="fas fa-info-circle"></i>
                Below is your dealer information. Click "View Detail" to manage your staff accounts.
            </div>

            <!-- 🟢 Bảng hiển thị danh sách Dealer -->
            <table class="table table-bordered table-hover bg-white align-middle">
                <thead class="table-primary text-center">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>EVM ID</th>
                    <th>Level ID</th>
                    <th>Policy ID</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                <tr th:each="dealer : ${dealers}">
                    <td th:text="${dealer.dealerID}" class="text-center"></td>
                    <td th:text="${dealer.dealerName}"></td>
                    <td th:text="${dealer.address}"></td>
                    <td th:text="${dealer.phone}"></td>
                    <td th:text="${dealer.email}"></td>
                    <td th:text="${dealer.evmID}" class="text-center"></td>
                    <td th:text="${dealer.levelID}" class="text-center"></td>
                    <td th:text="${dealer.policyID}" class="text-center"></td>
                    <td class="text-center">
                        <!-- 🟢 View Detail / Manage Accounts -->
                        <a th:href="@{'/dealer/' + ${dealer.dealerID} + '/detail'}"
                           class="btn btn-info btn-sm">
                            <i class="fas fa-eye"></i>
                            <span th:if="${isDealerView}">Manage Staff</span>
                            <span th:unless="${isDealerView}">View Detail</span>
                        </a>

                        <!-- 🟡 Nút Edit - ADMIN ONLY -->
                        <button th:unless="${isDealerView}" class="btn btn-warning btn-sm"
                                th:attr="data-id=${dealer.dealerID},
                                 data-name=${dealer.dealerName},
                                 data-address=${dealer.address},
                                 data-phone=${dealer.phone},
                                 data-email=${dealer.email},
                                 data-evm=${dealer.evmID},
                                 data-level=${dealer.levelID},
                                 data-policy=${dealer.policyID}"
                                onclick="editDealer(this)">
                            <i class="fas fa-edit"></i> Edit
                        </button>

                        <!-- 🟥 Delete with confirmation - ADMIN ONLY -->
                        <form th:unless="${isDealerView}"
                              th:action="@{'/dealer/' + ${dealer.dealerID} + '/delete'}"
                              method="post"
                              style="display:inline"
                              onsubmit="return confirm('⚠️ Are you sure you want to delete this dealer?\n\nDealer: ' + this.getAttribute('data-dealer-name') + '\n\nNote: This will fail if the dealer has customers or orders.');">
                            <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}"/>
                            <input type="hidden" th:value="${dealer.dealerName}" th:attr="data-dealer-name=${dealer.dealerName}"/>
                            <button class="btn btn-danger btn-sm" type="submit">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>

    </div>

</div>

</body>
</html>
